# ── Base de datos (MySQL/MariaDB — ya existe en phpMyAdmin) ────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eventos_culturales
DB_USER=root
DB_PASSWORD=

# ── Seguridad JWT ────────────────────────────────────────────────────
# Genera una nueva con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Lista separada por comas de orígenes permitidos para el frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
